DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_ecom?schema=public"
DATABASE_URL_UNPOOLED=""
# Optional: any value. If empty, the session key is derived from DATABASE_URL
SESSION_SECRET=""
# Optional: if set, /setup asks for this code before creating the first admin
SETUP_SECRET=""
BLOB_PRODUCTS_STORE_ID=""
BLOB_SLIPS_STORE_ID=""
# On Vercel, OIDC is provided automatically. For older token-based connections,
# use BLOB_PRODUCTS_READ_WRITE_TOKEN and BLOB_SLIPS_READ_WRITE_TOKEN instead.
